# Connection details for the testing server (ops/remote.sh). Copy to `.remote.env` — which is
# gitignored and must stay untracked — and fill in. REMOTE_KEY is a PATH to the private key; the
# key's contents are never read by anything in this repo, and neither this path nor the host may
# appear in any committed file.
REMOTE_HOST=
REMOTE_USER=
REMOTE_KEY=~/.ssh/
REMOTE_REPO=
