# The daily snapshotter (OPS). A systemd *user* unit, not system-wide: it runs as ubuntu, in
# ubuntu's `uv` environment, against ubuntu's lake, and needs no root for any of it.
#
# Why a timer rather than this repo's own long-running scheduler
# (`python -m dataplatform.scheduler run`): that process would start *every* registered job,
# including `eod_pipeline`, which has never run once. Turning on the whole scheduler is a much
# larger change than starting the snapshotter and is the owner's call, not this task's. The timer
# still goes through `SchedulerRunner.run_once`, so the lock, the `job_run` record and the
# heartbeat are all exactly as they would be under the scheduler.
#
# Survives a reboot: `loginctl enable-linger ubuntu` (the install step) starts ubuntu's user
# manager at boot without a login, and the timer is `WantedBy=timers.target`.

[Unit]
Description=Daily snapshot of every snapshot-only market-data source (trading-platform)
Documentation=file:///home/ubuntu/stock-manager/ops/runbooks/daily-snapshotter.md
# The lake and the database are both local; nothing to wait for but the network being up.
After=network-online.target
Wants=network-online.target
# systemd would otherwise retry a broken job forever; three attempts inside the hour rides out a
# blip, and a failure that survives that is one a human has to see.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/stock-manager
Environment=SNAPSHOT_REPO=/home/ubuntu/stock-manager
Environment=DATA_ROOT=/home/ubuntu/stock-manager/data
Environment=SNAPSHOT_EXPECT_LAKE_ROOT=/home/ubuntu/stock-manager/data/L0
Environment=SNAPSHOT_LOG_DIR=/home/ubuntu/snapshots
ExecStart=/home/ubuntu/stock-manager/ops/daily-snapshot.sh
# The job's own budget is 30 minutes and `run_once` records an overrun as TIMED_OUT rather than
# killing it. This is the outer bound: 25 sources at 3 s spacing cannot honestly need 45 minutes,
# so past that something is wedged and a stuck unit must not block tomorrow's fire.
TimeoutStartSec=45min
Nice=5
# One retry, ten minutes later. A transient 5xx or a brief network blip should not cost a day of
# history that cannot be recovered — and the job is idempotent, so a retry after a partial capture
# fetches only what is still missing.
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=default.target
