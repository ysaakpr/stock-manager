# ops/docker-compose.yml — compose-level configuration template.
#
#   cp ops/.env.example ops/.env    then edit ops/.env, which is gitignored and never committed.
#
# Compose's project directory is this file's directory (ops/), so it reads ops/.env for
# interpolation — never the repo-root .env, which is a separate file read by the app itself
# (dataplatform/config.py:Settings) and passed into the container via `env_file`.
#
# There are no real values in this file (invariant #13). POSTGRES_USER/DB are identifiers, not
# secrets, and keep their working defaults inside docker-compose.yml; POSTGRES_PASSWORD has no
# default there on purpose, so it must be set here (or in the environment) before the first
# `make up` — uncomment and fill in a value of your choosing.
#
# The password may contain any character — space, @, /, %, #, ?, : — without escaping. Compose
# passes these to the app as five discrete variables and never assembles them into a
# `postgresql://` DSN, so nothing here is ever read as URI grammar (ops/README.md, "Compose
# never builds a DSN"). Do not add a DATABASE_URL to this file: the app container is given an
# empty one on purpose.

# ── postgres ─────────────────────────────────────────────────────────────────────────────────
# Required. `docker compose up` refuses to start without it — see ops/docker-compose.yml.
#POSTGRES_PASSWORD=

# Identifiers, not credentials. Uncomment only to change them from the compose defaults (trading).
#POSTGRES_USER=
#POSTGRES_DB=

# ── host-side ports ──────────────────────────────────────────────────────────────────────────
# Host-side publish for Postgres (bound to 127.0.0.1 only). Change only if 5433 collides with
# something else already on this host; see ops/README.md for why the default is not 5432.
#POSTGRES_HOST_PORT=

# Host-side publish for the status API.
#APP_HOST_PORT=

# ── data lake ────────────────────────────────────────────────────────────────────────────────
# Host path bind-mounted into the app container at /data. Defaults to ../data (repo-root data/).
#DATA_ROOT=
