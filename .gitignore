# data lake — never committed (L0 is immutable on disk, not in git). Anchored: unanchored `data/`
# also matches package data directories such as dataplatform/ingest/data/, which are checked in.
/data/
# secrets
.env
.env.*
!.env.example
.build_state.lock
# credential files (invariant #13) — a secret belongs in the environment or .env, never a file
# that could be dropped into the tree by mistake and picked up by a broad `git add`.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
service-account*.json
id_rsa*
ops/build-logs/
ops/backups/
# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
# artifacts
*.parquet
*.duckdb
.DS_Store
